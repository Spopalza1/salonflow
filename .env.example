# Original SalonFlow Base44 backend (contains the existing users and data)
VITE_BASE44_APP_ID=6a5ed621ac293f2abc6083e5

# Public frontend used by Electron-generated QR codes.
# Replace with your verified custom domain when ready.
VITE_PUBLIC_APP_URL=https://artichoke-salon-sync-flow.base44.app

# Optional: only set this if Base44 explicitly provides a backend base URL.
# Do not set it to localhost in a production build.
# VITE_BASE44_APP_BASE_URL=

# Optional functions version.
# VITE_BASE44_FUNCTIONS_VERSION=
