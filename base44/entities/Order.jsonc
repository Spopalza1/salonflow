{
  "name": "Order",
  "type": "object",
  "properties": {
    "item_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "requested_by_type": {
      "type": "string",
      "enum": [
        "stylist",
        "guest"
      ]
    },
    "requested_by_name": {
      "type": "string"
    },
    "requested_by_user_id": {
      "type": "string"
    },
    "chair_table": {
      "type": "string"
    },
    "guest_session": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "preparing",
        "served",
        "cancelled"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    },
    "customizations": {
      "type": "string"
    },
    "salon_id": {
      "type": "string"
    }
  },
  "required": [
    "item_name",
    "requested_by_type",
    "requested_by_name"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.salon_id": "{{user.data.salon_id}}",
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.requested_by_user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.salon_id": "{{user.data.salon_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.salon_id": "{{user.data.salon_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}