{
  "name": "GuestMessage",
  "type": "object",
  "properties": {
    "guest_name": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "guest",
        "front_desk"
      ],
      "default": "guest"
    },
    "guest_session": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "printed": {
      "type": "boolean",
      "default": false
    },
    "salon_id": {
      "type": "string"
    }
  },
  "required": [
    "guest_name",
    "message"
  ],
  "rls": {
    "create": true,
    "read": {
      "data.salon_id": "{{user.data.salon_id}}"
    },
    "update": {
      "data.salon_id": "{{user.data.salon_id}}"
    },
    "delete": {
      "data.salon_id": "{{user.data.salon_id}}"
    }
  }
}