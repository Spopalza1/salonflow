{
  "name": "MenuItemOptionGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "extra_price": {
            "type": "number"
          }
        }
      }
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "allow_multiple": {
      "type": "boolean",
      "default": false
    },
    "menu_item_id": {
      "type": "string"
    },
    "salon_id": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "menu_item_id",
    "salon_id"
  ],
  "rls": {
    "create": true,
    "read": {
      "data.salon_id": "{{user.data.salon_id}}"
    },
    "update": {
      "data.salon_id": "{{user.data.salon_id}}"
    },
    "delete": {
      "data.salon_id": "{{user.data.salon_id}}"
    }
  }
}