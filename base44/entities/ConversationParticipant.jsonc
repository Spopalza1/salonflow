{
  "name": "ConversationParticipant",
  "type": "object",
  "properties": {
    "salon_id": { "type": "string" },
    "conversation_id": { "type": "string" },
    "user_id": { "type": "string" },
    "participant_role": { "type": "string" },
    "last_read_sequence": { "type": "number", "default": 0 },
    "last_read_at": { "type": "string", "format": "date-time" },
    "hidden_at": { "type": "string", "format": "date-time" }
  },
  "required": ["salon_id", "conversation_id", "user_id"],
  "rls": {
    "create": { "data.salon_id": "{{user.data.salon_id}}" },
    "read": { "data.salon_id": "{{user.data.salon_id}}" },
    "update": { "data.user_id": "{{user.id}}" },
    "delete": { "data.user_id": "{{user.id}}" }
  }
}
