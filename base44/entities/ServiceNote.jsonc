{
  "name": "ServiceNote",
  "type": "object",
  "properties": {
    "service_id": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "note_type": {
      "type": "string",
      "enum": [
        "note",
        "extension",
        "extra_service"
      ],
      "default": "note"
    },
    "content": {
      "type": "string"
    }
  },
  "required": [
    "service_id",
    "author_name",
    "content"
  ]
}